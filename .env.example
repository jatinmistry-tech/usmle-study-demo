# Copy to .env at the repository root. Never commit real credentials.
# Leave NODE_ENV unset locally so Vite selects development/build mode correctly.
# Render injects NODE_ENV=production into the server services.
API_PORT=4001
BFF_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4001
# Timeout includes the upstream response body, not just response headers.
API_TIMEOUT_MS=8000
# Use the same secret in the API and BFF. Required in production.
API_KEY=
# Separate secret for trusted content administration. Never pass it to the BFF/web.
API_ADMIN_KEY=
# Leave blank for ephemeral, in-memory practice sessions.
# Runtime: paste the Neon pooled connection string, retaining TLS parameters.
# Example format only: postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL=
# Prisma migrations: paste the direct connection string (without -pooler).
# Keep this server-side, retaining the TLS parameters supplied by Neon.
DIRECT_URL=
# Blank uses Vite's /bff proxy locally. In Render, set the public BFF origin.
VITE_BFF_URL=
