{
  "name": "@usmle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx prisma/cli.ts migrate deploy",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "tsx prisma/cli.ts migrate dev",
    "db:seed": "tsx prisma/cli.ts db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@usmle/shared": "*",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  }
}
